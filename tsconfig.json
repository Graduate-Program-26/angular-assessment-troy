{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./libs/spartan-ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/spartan-ui/utils/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./libs/spartan-ui/sidebar/src/index.ts"],
      "@spartan-ng/helm/icon": ["./libs/spartan-ui/icon/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/spartan-ui/input/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/spartan-ui/separator/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./libs/spartan-ui/sheet/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./libs/spartan-ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./libs/spartan-ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/spartan-ui/card/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./libs/spartan-ui/spinner/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./libs/spartan-ui/avatar/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./libs/spartan-ui/dropdown-menu/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
